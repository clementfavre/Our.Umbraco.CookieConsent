{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Our.Umbraco.CookieConsent",
  "version": "17.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "Our.Umbraco.CookieConsent.Dashboard",
      "name": "Cookie Consent Dashboard",
      "element": "/App_Plugins/Our.Umbraco.CookieConsent/cookie-consent-dashboard.js",
      "elementName": "cookie-consent-dashboard",
      "weight": 11,
      "meta": {
        "label": "#cookieConsent_menuLabel",
        "pathname": "cookie-consent"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "Our.Umbraco.CookieConsent.Localization.En",
      "name": "English",
      "meta": {
        "culture": "en"
      },
      "js": "/App_Plugins/Our.Umbraco.CookieConsent/localization/en.js"
    },
    {
      "type": "localization",
      "alias": "Our.Umbraco.CookieConsent.Localization.EnUs",
      "name": "English (United States)",
      "meta": {
        "culture": "en-us"
      },
      "js": "/App_Plugins/Our.Umbraco.CookieConsent/localization/en.js"
    },
    {
      "type": "localization",
      "alias": "Our.Umbraco.CookieConsent.Localization.Fr",
      "name": "French",
      "meta": {
        "culture": "fr"
      },
      "js": "/App_Plugins/Our.Umbraco.CookieConsent/localization/fr.js"
    },
    {
      "type": "localization",
      "alias": "Our.Umbraco.CookieConsent.Localization.De",
      "name": "German",
      "meta": {
        "culture": "de"
      },
      "js": "/App_Plugins/Our.Umbraco.CookieConsent/localization/de.js"
    }
  ]
}
